/*
 * v08b_a440  ---  検証⑧b：tone() の周波数が正確かを「測って」確かめる
 *
 * v08 で音階は鳴った。ただし耳で音名を当てるのは難しいので、
 * **440Hz（ラ／A4）を鳴らしっぱなし**にして、スマホのチューナーアプリで測る。
 *
 * 使いかた
 *   1. 書きこむ（ブザーは 7番ピンと GND のまま）
 *   2. スマホに無料のチューナーアプリを入れる
 *      （「チューナー」「Guitar Tuna」「Pano Tuner」など何でもよい）
 *   3. マイクをブザーに近づけて、表示を読む
 *
 * 見かた
 *   A（ラ）／440Hz 付近  → tone() は正確 ◎ b5 でメロディを鳴らせる
 *   B（シ）／494Hz 付近  → 約 12% 高い。周波数の指定に補正が必要
 *   その他               → ずれ幅を記録しておく（補正値の計算に使う）
 *
 * ずれていた場合の直し方
 *   ずれの比率がわかれば、tone(pin, 周波数 / 比率) で補正できる。
 *   例：12% 高いなら tone(BUZZER, 440 / 1.12) と書けば実際に 440Hz が出る。
 *   ただし教材に補正式を書くのは避けたいので、ずれが大きいときは
 *   「音の高さを変える」体験にとどめ、正確な音階は狙わない構成にする。
 *
 * 基板のオレンジLEDは1秒ごとに点滅（プログラムが動いているしるし）。
 */

const int BUZZER = 7;
const int LED    = 2;

void setup() {
  pinMode(LED, OUTPUT);
  tone(BUZZER, 440);        // ラ（A4）を鳴らしっぱなし
}

void loop() {
  digitalWrite(LED, HIGH);
  delay(1000);
  digitalWrite(LED, LOW);
  delay(1000);
}
